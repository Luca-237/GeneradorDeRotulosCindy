# Raíz del repo publicada en rotulos.bagsstore.com.ar (Ferozo GIT -> /public_html/rotulos/).
# La app vive en "impresion de rotulos/": se sirve desde ahí sin cambiar la URL.
RewriteEngine On
RewriteRule "^(?!impresion de rotulos/)(.*)$" "impresion de rotulos/$1" [L]

<Files "README.md">
  Require all denied
</Files>
